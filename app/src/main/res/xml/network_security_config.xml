<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows plain HTTP to the Android emulator's host-loopback alias, used only
         when ExpenslyApp points Firebase at the local Emulator Suite in debug builds. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
